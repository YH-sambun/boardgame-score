rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }

    // 내 계정 전용 데이터 (참가자 목록, 설정, 예전 기록)
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── 친구 ──
    // 두 사람 uid 를 작은 것부터 '_' 로 이은 것이 친구 관계 문서 id
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function isFriend(uid) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(uid, request.auth.uid)));
    }

    // 친구 코드: 코드를 아는 사람만 그 문서 하나를 읽을 수 있음 (목록 조회 불가). 덮어쓰기 불가
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && code.size() == 6 && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 친구 관계: 상대의 친구 코드를 알아야 만들 수 있고, 두 사람만 읽고 끊을 수 있음
    match /friendships/{id} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid
           == (request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]);
    }

    // 오늘의 문제 결과: 본인만 쓰고, 본인과 친구만 읽음
    match /dailyScores/{uid}/items/{item} {
      allow read: if signedIn() && (request.auth.uid == uid || isFriend(uid));
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // 게임 기록: 만든 사람 + 참가자에 이메일이 연결된 사람
    match /sessions/{id} {
      function isOwner() { return resource.data.ownerUid == request.auth.uid; }
      function isViewer() { return myEmail() in resource.data.viewerEmails; }

      allow read: if signedIn() && (isOwner() || isViewer());
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // 만든 사람은 모두 수정, 공유받은 사람은 점수만 수정 (소유자·공유 대상은 못 바꿈)
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (isOwner() || (isViewer() && request.resource.data.viewerEmails == resource.data.viewerEmails));
      allow delete: if signedIn() && isOwner();

      // (예전) 개인 노트 위치. 지금은 users/{uid}/notes 에 저장하며, 여기는 예전 노트 읽기·삭제용
      match /notes/{noteUid} {
        function canSeeGame() {
          let g = get(/databases/$(database)/documents/sessions/$(id)).data;
          return g.ownerUid == request.auth.uid || myEmail() in g.viewerEmails;
        }
        allow read, delete: if signedIn() && request.auth.uid == noteUid;
        allow create, update: if signedIn() && request.auth.uid == noteUid && canSeeGame();
      }
    }
  }
}
